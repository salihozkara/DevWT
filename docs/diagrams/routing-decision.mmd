    Image -->|No match| Fallback["Global or per-port fallback"]
    Fallback -->|No match| Remembered["Remembered or newest listener"]
    Single --> Route["Proxy to selected backend"]
    Explicit -->|Match| Route
    Browser -->|Match| Route
    Caller -->|Match| Route
    Cookie -->|Match| Route
    Image -->|Match| Route
    Fallback -->|Match| Route
    Remembered --> Route

